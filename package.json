{
  "name": "@keletes/svmq",
  "version": "0.0.0-development",
  "description": "Native System V message queues in Node.js",
  "main": "index.js",
  "scripts": {
    "test": "jasmine",
    "test:types": "tsc -p test/tsconfig.json",
    "prebuild": "prebuildify --napi --strip --tag-libc",
    "install": "node-gyp-build",
    "verify": "yarn test:types && yarn test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keletes/node-svmq.git"
  },
  "keywords": [
    "system",
    "v",
    "sysv",
    "mq",
    "message",
    "queue",
    "svmq",
    "ipc"
  ],
  "author": "Justin Head <jhead@jxh.io>",
  "license": "MIT",
  "gypfile": true,
  "bugs": {
    "url": "https://github.com/keletes/node-svmq/issues"
  },
  "homepage": "https://github.com/keletes/node-svmq#readme",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jasmine": "^3.6.1",
    "node-gyp": "^13.1.0",
    "prebuildify": "^6.0.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "binding.gyp",
    "index.js",
    "index.d.ts",
    "lib",
    "src",
    "prebuilds"
  ],
  "types": "index.d.ts",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "engines": {
    "node": ">=18"
  }
}
